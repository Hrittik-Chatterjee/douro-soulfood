---
export const prerender = true;

import Base from '@/layouts/Base.astro';
import NavBar from '@/components/layout/NavBar.astro';
import Footer from '@/components/layout/Footer.astro';
import MenuItemCard from '@/components/sections/MenuItemCard.astro';
import MenuBistroCard from '@/components/sections/MenuBistroCard.astro';
import AllergenHeaderLegend from '@/components/ui/AllergenHeaderLegend.astro';
import CategoryIcon from '@/components/ui/CategoryIcon.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { categoryConfig, drinkSubLabels, getSortedGroupedMenu, type DietaryTag } from '@/lib/menu';

/**
 * MENU PAGE — D'ouro Soulfood Bistro
 */

/** Fetch all menu items from KeystaticCMS */
const allItems = await getCollection('menu_items');

const { sortedCategories } = getSortedGroupedMenu(allItems);
---

<Base title="Speisekarte">
  <NavBar slot="nav" />

  <!-- ═══ HERO HEADER ═══ -->
  <section class="pt-28 pb-4 md:pt-32 md:pb-4 px-4 md:px-16 max-w-7xl mx-auto">
    <h1 class="text-4xl md:text-6xl lg:text-7xl font-extrabold text-brand-gold-ink mb-6 font-display uppercase tracking-tight">
      Speisekarte
    </h1>
    <p class="text-lg md:text-xl text-text-secondary max-w-[52ch] leading-relaxed">
      Jedes Gericht wird frisch und von Hand zubereitet — mit den Aromen Brasiliens und der Wärme Afrikas.
      Angela kocht alles selbst, mit Liebe und den besten Zutaten.
    </p>

    <!-- Quick category navigation -->
    <nav class="flex flex-wrap gap-2.5 mt-8 mb-4" aria-label="Menü-Kategorien">
      {sortedCategories.map(([slug]) => {
        const config = categoryConfig[slug];
        if (!config) return null;
        return (
          <a
            href={`#category-${slug}`}
            class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-bold uppercase tracking-wider rounded-lg
                   bg-surface-card border border-border-subtle text-text-secondary
                   hover:bg-surface-elevated hover:border-brand-gold hover:text-brand-gold-ink
                   active:bg-surface-primary
                   focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold
                   no-underline transition-all duration-[var(--duration-fast)] ease-[var(--ease-spring)]"
          >
            <CategoryIcon name={config.icon} class="w-4 h-4 text-brand-gold" />
            {config.label}
          </a>
        );
      })}
    </nav>

    {/* Top Allergen Legend matching bistro menu reference */}
    <AllergenHeaderLegend />
  </section>

  <!-- ═══ MENU CATEGORIES ═══ -->
  {sortedCategories.map(([slug, items]) => {
    const config = categoryConfig[slug] ?? { label: slug, order: 99, icon: 'mains' };

    // Special layout for Bebidas: Render 4 sub-categories (Águas Frescas, Cocktails, Softdrinks, Cafés) with MenuBistroCard
    if (slug === 'drinks') {
      const subCategoryOrder = ['aguas-frescas', 'cocktails', 'softdrinks', 'cafes'];
      const subGrouped = subCategoryOrder.map((subSlug) => {
        const subItems = items.filter((item) => item.data.subCategory === subSlug || (!item.data.subCategory && subSlug === 'softdrinks'));
        return { subSlug, subItems };
      }).filter(({ subItems }) => subItems.length > 0);


      return (
        <section
          id={`category-${slug}`}
          class="pt-2 pb-8 md:pt-4 md:pb-12 px-4 md:px-16 max-w-7xl mx-auto scroll-mt-20 space-y-10"
        >
          {/* Main Category Banner Header */}
          <div class="flex justify-center mb-6">
            <div class="inline-flex items-center gap-3 bg-(--color-bistro-banner) border-2 border-(--color-bistro-banner-border) px-6 sm:px-10 py-3 rounded-sm shadow-md text-center">
              <h2 class="text-xl sm:text-2xl md:text-3xl font-serif font-extrabold text-(--color-bistro-banner-text) tracking-widest uppercase leading-snug">
                {config.label}
              </h2>
            </div>
          </div>

          {/* Sub-categories loop */}
          <div class="space-y-10">
            {subGrouped.map(({ subSlug, subItems }) => {
              const subMeta = drinkSubLabels[subSlug] ?? { label: subSlug, icon: '🍹' };
              return (
                <div class="space-y-4">
                  {/* Sub-category header */}
                  <div class="flex items-center gap-2.5 pb-2 border-b-2 border-(--color-bistro-banner-border)/30">
                    <span class="text-xl" aria-hidden="true">{subMeta.icon}</span>
                    <h3 class="text-lg md:text-xl font-serif font-extrabold text-(--color-bistro-ink) uppercase tracking-wider">
                      {subMeta.label}
                    </h3>
                  </div>

                  {/* Sub-category grid: 2 cards per row using MenuBistroCard */}
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 lg:gap-6">
                    {subItems.map((item) => (
                      <MenuBistroCard
                        name={item.data.title}
                        description={item.data.description}
                        descriptionEn={item.data.descriptionEn}
                        priceInCents={item.data.price}
                        priceVariants={item.data.priceVariants}
                        prepTime={item.data.prepTime}
                        prepTimeEn={item.data.prepTimeEn}
                        allergens={item.data.allergens}
                        addOns={item.data.addOns}
                        imageSrc={item.data.image || undefined}
                        imageAlt={item.data.title}
                        available={item.data.available}
                      />
                    ))}
                  </div>
                </div>
              );
            })}
          </div>

          </div>
        </section>
      );
    }

    // Special layout for Entradas (Appetizers): Bistro paper menu layout
    if (slug === 'appetizers') {
      return (
        <section
          id={`category-${slug}`}
          class="pt-2 pb-8 md:pt-4 md:pb-12 px-4 md:px-16 max-w-7xl mx-auto scroll-mt-20"
        >
          {/* Category Banner Header */}
          <div class="flex justify-center mb-6">
            <div class="inline-flex items-center gap-3 bg-(--color-bistro-banner) border-2 border-(--color-bistro-banner-border) px-6 sm:px-10 py-3 rounded-sm shadow-md text-center">
              <h2 class="text-xl sm:text-2xl md:text-3xl font-serif font-extrabold text-(--color-bistro-banner-text) tracking-widest uppercase leading-snug">
                {config.label}
              </h2>
            </div>
          </div>

          {/* Entradas Bistro Cards Grid: 2 cards per row on desktop/tablet */}
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 lg:gap-6">
            {items.map((item) => (
              <MenuBistroCard
                name={item.data.title}
                description={item.data.description}
                descriptionEn={item.data.descriptionEn}
                priceInCents={item.data.price}
                prepTime={item.data.prepTime}
                prepTimeEn={item.data.prepTimeEn}
                allergens={item.data.allergens}
                imageSrc={item.data.image || undefined}
                imageAlt={item.data.title}
                available={item.data.available}
              />
            ))}
          </div>

          {/* Section-Specific Allergen Legend */}
          <div class="mt-6">
            <AllergenHeaderLegend allergens={items.flatMap((i) => i.data.allergens || [])} />
          </div>
        </section>
      );
    }

    // Special layout for Quesadillas: Option B (Category Feature Banner + Bistro Cards Grid)
    if (slug === 'quesadillas') {
      return (
        <section
          id={`category-${slug}`}
          class="pt-4 pb-8 md:pt-6 md:pb-12 px-4 md:px-16 max-w-7xl mx-auto scroll-mt-20"
        >
          {/* Category Banner Header */}
          <div class="flex justify-center mb-6">
            <div class="inline-flex items-center gap-3 bg-(--color-bistro-banner) border-2 border-(--color-bistro-banner-border) px-6 sm:px-10 py-3 rounded-sm shadow-md text-center">
              <h2 class="text-xl sm:text-2xl md:text-3xl font-serif font-extrabold text-(--color-bistro-banner-text) tracking-widest uppercase leading-snug">
                {config.label}
              </h2>
            </div>
          </div>

          {/* 3-Photo Showcase Row */}
          <div class="mb-8 rounded-sm overflow-hidden bg-(--color-bistro-paper) border border-(--color-bistro-paper-border) shadow-sm p-3.5 sm:p-5 max-w-4xl lg:max-w-5xl mx-auto">
            <div class="grid grid-cols-3 gap-3 sm:gap-4">
              <div class="aspect-square rounded-md overflow-hidden shadow-inner bg-(--color-bistro-placeholder)">
                <Image
                  src="/images/menu/Quesadillas.webp"
                  alt="D'ouro Quesadillas"
                  width={1254}
                  height={1254}
                  class="w-full h-full object-cover hover:scale-105 transition-transform duration-300 ease-out"
                  loading="lazy"
                />
              </div>
              <div class="aspect-square rounded-md overflow-hidden shadow-inner bg-(--color-bistro-placeholder)">
                <Image
                  src="/images/menu/quesdillas2.webp"
                  alt="D'ouro Quesadillas 2"
                  width={2048}
                  height={2048}
                  class="w-full h-full object-cover hover:scale-105 transition-transform duration-300 ease-out"
                  loading="lazy"
                />
              </div>
              <div class="aspect-square rounded-md overflow-hidden shadow-inner bg-(--color-bistro-placeholder)">
                <Image
                  src="/images/menu/ques3.webp"
                  alt="D'ouro Quesadillas 3"
                  width={2048}
                  height={2048}
                  class="w-full h-full object-cover hover:scale-105 transition-transform duration-300 ease-out"
                  loading="lazy"
                />
              </div>
            </div>
          </div>

          {/* Quesadillas Bistro Cards Grid */}
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 lg:gap-6">
            {items.map((item) => (
              <MenuBistroCard
                name={item.data.title}
                description={item.data.description}
                descriptionEn={item.data.descriptionEn}
                priceInCents={item.data.price}
                prepTime={item.data.prepTime}
                prepTimeEn={item.data.prepTimeEn}
                allergens={item.data.allergens}
                imageSrc={item.data.image || undefined}
                imageAlt={item.data.title}
                available={item.data.available}
              />
            ))}
          </div>

          {/* Section-Specific Allergen Legend */}
          <div class="mt-6">
            <AllergenHeaderLegend allergens={items.flatMap((i) => i.data.allergens || [])} />
          </div>
        </section>
      );
    }

    // Special layout for Tacos: 3-Photo Showcase Row + Bistro Cards Grid
    if (slug === 'tacos') {
      return (
        <section
          id={`category-${slug}`}
          class="pt-4 pb-8 md:pt-6 md:pb-12 px-4 md:px-16 max-w-7xl mx-auto scroll-mt-20"
        >
          {/* Category Banner Header */}
          <div class="flex justify-center mb-6">
            <div class="inline-flex items-center gap-3 bg-(--color-bistro-banner) border-2 border-(--color-bistro-banner-border) px-6 sm:px-10 py-3 rounded-sm shadow-md text-center">
              <h2 class="text-xl sm:text-2xl md:text-3xl font-serif font-extrabold text-(--color-bistro-banner-text) tracking-widest uppercase leading-snug">
                {config.label}
              </h2>
            </div>
          </div>

          {/* 3-Photo Showcase Row (Each photo matches Quesadillas photo height) */}
          <div class="mb-8 rounded-sm overflow-hidden bg-(--color-bistro-paper) border border-(--color-bistro-paper-border) shadow-sm p-3.5 sm:p-5 max-w-4xl lg:max-w-5xl mx-auto">
            <div class="grid grid-cols-3 gap-3 sm:gap-4">
              <div class="w-full aspect-square rounded-md overflow-hidden shadow-inner bg-(--color-bistro-placeholder)">
                <Image
                  src="/images/menu/tacos1.webp"
                  alt="D'ouro Taco Showcase 1"
                  width={1254}
                  height={1254}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
              <div class="w-full aspect-square rounded-md overflow-hidden shadow-inner bg-(--color-bistro-placeholder)">
                <Image
                  src="/images/menu/tacos2.webp"
                  alt="D'ouro Taco Showcase 2"
                  width={1254}
                  height={1254}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
              <div class="w-full aspect-square rounded-md overflow-hidden shadow-inner bg-(--color-bistro-placeholder)">
                <Image
                  src="/images/menu/tacos3.webp"
                  alt="D'ouro Taco Showcase 3"
                  width={1254}
                  height={1254}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
            </div>
          </div>

          {/* Tacos Bistro Cards Grid */}
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 lg:gap-6">
            {items.map((item) => (
              <MenuBistroCard
                name={item.data.title}
                description={item.data.description}
                descriptionEn={item.data.descriptionEn}
                priceInCents={item.data.price}
                prepTime={item.data.prepTime}
                prepTimeEn={item.data.prepTimeEn}
                allergens={item.data.allergens}
                imageSrc={item.data.image || undefined}
                imageAlt={item.data.title}
                available={item.data.available}
              />
            ))}
          </div>

          {/* Section-Specific Allergen Legend */}
          <div class="mt-6">
            <AllergenHeaderLegend allergens={items.flatMap((i) => i.data.allergens || [])} />
          </div>
        </section>
      );
    }

    // Special layout for Bowls: 3-Photo Showcase Row + Bistro Cards Grid
    if (slug === 'bowls') {
      return (
        <section
          id={`category-${slug}`}
          class="pt-4 pb-8 md:pt-6 md:pb-12 px-4 md:px-16 max-w-7xl mx-auto scroll-mt-20"
        >
          {/* Category Banner Header */}
          <div class="flex justify-center mb-6">
            <div class="inline-flex flex-col items-center gap-1 bg-(--color-bistro-banner) border-2 border-(--color-bistro-banner-border) px-6 sm:px-10 py-3 rounded-sm shadow-md text-center">
              <h2 class="text-xl sm:text-2xl md:text-3xl font-serif font-extrabold text-(--color-bistro-banner-text) tracking-widest uppercase leading-snug">
                {config.label}
              </h2>
              <span class="text-xs sm:text-sm font-sans font-medium text-(--color-bistro-banner-border)/80 tracking-wide">(1 Stk. / 1 Piece)</span>
            </div>
          </div>

          {/* 3-Photo Showcase Row */}
          <div class="mb-8 rounded-sm overflow-hidden bg-(--color-bistro-paper) border border-(--color-bistro-paper-border) shadow-sm p-3.5 sm:p-5 max-w-4xl lg:max-w-5xl mx-auto">
            <div class="grid grid-cols-3 gap-3 sm:gap-4">
              <div class="w-full aspect-square rounded-md overflow-hidden shadow-inner bg-(--color-bistro-placeholder)">
                <Image
                  src="/images/menu/bowl1.webp"
                  alt="D'ouro Bowls Showcase 1"
                  width={1254}
                  height={1254}
                  format="jpeg"
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
              <div class="w-full aspect-square rounded-md overflow-hidden shadow-inner bg-(--color-bistro-placeholder)">
                <Image
                  src="/images/menu/bowl2.webp"
                  alt="D'ouro Bowls Showcase 2"
                  width={1254}
                  height={1254}
                  format="jpeg"
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
              <div class="w-full aspect-square rounded-md overflow-hidden shadow-inner bg-(--color-bistro-placeholder)">
                <Image
                  src="/images/menu/bowl3.webp"
                  alt="D'ouro Bowls Showcase 3"
                  width={1254}
                  height={1254}
                  format="jpeg"
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
            </div>
          </div>

          {/* Bowls Bistro Cards Grid */}
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 lg:gap-6">
            {items.map((item) => (
              <MenuBistroCard
                name={item.data.title}
                description={item.data.description}
                descriptionEn={item.data.descriptionEn}
                priceInCents={item.data.price}
                prepTime={item.data.prepTime}
                prepTimeEn={item.data.prepTimeEn}
                allergens={item.data.allergens}
                imageSrc={item.data.image || undefined}
                imageAlt={item.data.title}
                available={item.data.available}
              />
            ))}
          </div>

          {/* Section-Specific Allergen Legend */}
          <div class="mt-6">
            <AllergenHeaderLegend allergens={items.flatMap((i) => i.data.allergens || [])} />
          </div>
        </section>
      );
    }

    // Special layout for Pratos Feitos (mains): Individual Dish Photos (like Entradas) + Clean Text Cards
    if (slug === 'mains') {
      return (
        <section
          id={`category-${slug}`}
          class="pt-2 pb-8 md:pt-4 md:pb-12 px-4 md:px-16 max-w-7xl mx-auto scroll-mt-20"
        >
          {/* Category Banner Header */}
          <div class="flex justify-center mb-6">
            <div class="inline-flex items-center gap-3 bg-(--color-bistro-banner) border-2 border-(--color-bistro-banner-border) px-6 sm:px-10 py-3 rounded-sm shadow-md text-center">
              <h2 class="text-xl sm:text-2xl md:text-3xl font-serif font-extrabold text-(--color-bistro-banner-text) tracking-widest uppercase leading-snug">
                {config.label}
              </h2>
            </div>
          </div>

          {/* Pratos Feitos Bistro Cards Grid */}
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 lg:gap-6">
            {items.map((item) => (
              <MenuBistroCard
                name={item.data.title}
                description={item.data.description}
                descriptionEn={item.data.descriptionEn}
                priceInCents={item.data.price}
                prepTime={item.data.prepTime}
                prepTimeEn={item.data.prepTimeEn}
                allergens={item.data.allergens}
                addOns={item.data.addOns}
                imageSrc={item.data.image || undefined}
                imageAlt={item.data.title}
                available={item.data.available}
              />
            ))}
          </div>

          {/* Section-Specific Allergen Legend */}
          <div class="mt-6">
            <AllergenHeaderLegend allergens={items.flatMap((i) => i.data.allergens || [])} />
          </div>
        </section>
      );
    }

    // Special layout for Pratos de Mar (seafood): Top 2 Dish Photos + Clean Text Card
    if (slug === 'seafood') {
      return (
        <section
          id={`category-${slug}`}
          class="pt-2 pb-8 md:pt-4 md:pb-12 px-4 md:px-16 max-w-7xl mx-auto scroll-mt-20"
        >
          {/* Category Banner Header */}
          <div class="flex justify-center mb-6">
            <div class="inline-flex items-center gap-3 bg-(--color-bistro-banner) border-2 border-(--color-bistro-banner-border) px-6 sm:px-10 py-3 rounded-sm shadow-md text-center">
              <h2 class="text-xl sm:text-2xl md:text-3xl font-serif font-extrabold text-(--color-bistro-banner-text) tracking-widest uppercase leading-snug">
                {config.label}
              </h2>
            </div>
          </div>

          {/* Pratos de Mar Bistro Cards Grid */}
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 lg:gap-6">
            {items.map((item) => (
              <MenuBistroCard
                name={item.data.title}
                description={item.data.description}
                descriptionEn={item.data.descriptionEn}
                priceInCents={item.data.price}
                prepTime={item.data.prepTime}
                prepTimeEn={item.data.prepTimeEn}
                allergens={item.data.allergens}
                addOns={item.data.addOns}
                imageSrc={item.data.image || undefined}
                imageAlt={item.data.title}
                available={item.data.available}
              />
            ))}
          </div>

          {/* Section-Specific Allergen Legend */}
          <div class="mt-6">
            <AllergenHeaderLegend allergens={items.flatMap((i) => i.data.allergens || [])} />
          </div>
        </section>
      );
    }

    // Special layout for Sobremesas (desserts): Entradas Style with 1:1 Dish Photos
    if (slug === 'desserts') {
      return (
        <section
          id={`category-${slug}`}
          class="pt-2 pb-8 md:pt-4 md:pb-12 px-4 md:px-16 max-w-7xl mx-auto scroll-mt-20"
        >
          {/* Category Banner Header */}
          <div class="flex justify-center mb-6">
            <div class="inline-flex items-center gap-3 bg-(--color-bistro-banner) border-2 border-(--color-bistro-banner-border) px-6 sm:px-10 py-3 rounded-sm shadow-md text-center">
              <h2 class="text-xl sm:text-2xl md:text-3xl font-serif font-extrabold text-(--color-bistro-banner-text) tracking-widest uppercase leading-snug">
                {config.label}
              </h2>
            </div>
          </div>

          {/* Sobremesas Bistro Cards Grid */}
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 lg:gap-6">
            {items.map((item) => (
              <MenuBistroCard
                name={item.data.title}
                description={item.data.description}
                descriptionEn={item.data.descriptionEn}
                priceInCents={item.data.price}
                prepTime={item.data.prepTime}
                prepTimeEn={item.data.prepTimeEn}
                allergens={item.data.allergens}
                addOns={item.data.addOns}
                imageSrc={item.data.image || undefined}
                imageAlt={item.data.title}
                available={item.data.available}
              />
            ))}
          </div>

          {/* Section-Specific Allergen Legend */}
          <div class="mt-6">
            <AllergenHeaderLegend allergens={items.flatMap((i) => i.data.allergens || [])} />
          </div>
        </section>
      );
    }



    return (
      <section
        id={`category-${slug}`}
        class="py-8 md:py-12 px-4 md:px-16 max-w-7xl mx-auto scroll-mt-20"
      >
        {/* Category heading */}
        <div class="flex items-center gap-3.5 mb-8">
          <div class="w-10 h-10 rounded-xl bg-brand-gold/15 text-brand-gold flex items-center justify-center">
            <CategoryIcon name={config.icon} class="w-6 h-6" />
          </div>
          <h2 class="text-2xl md:text-3xl lg:text-4xl font-extrabold text-text-primary font-display uppercase tracking-wider">
            {config.label}
          </h2>
          <div class="flex-1 h-0.5 bg-border-subtle ml-2"></div>
        </div>

        {/* Menu items grid */}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
          {items.map((item) => (
            <MenuItemCard
              name={item.data.title}
              description={item.data.description}
              priceInCents={item.data.price}
              priceVariants={item.data.priceVariants}
              dietary={item.data.dietary as DietaryTag[] | undefined}
              allergens={item.data.allergens}
              prepTime={item.data.prepTime}
              addOns={item.data.addOns}
              available={item.data.available}
              featured={item.data.featured}
              imageSrc={item.data.image || undefined}
              imageAlt={item.data.title}
              imageWidth={400}
              imageHeight={300}
            />
          ))}
        </div>

        {/* Section-Specific Allergen Legend */}
        <div class="mt-6">
          <AllergenHeaderLegend allergens={items.flatMap((i) => i.data.allergens || [])} />
        </div>
      </section>
    );
  })}

  <!-- ═══ EMPTY STATE ═══ -->
  {sortedCategories.length === 0 && (
