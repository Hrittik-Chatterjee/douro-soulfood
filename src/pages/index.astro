---
export const prerender = true;

import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Button from '@/components/ui/Button.astro';
import NavBar from '@/components/layout/NavBar.astro';
import HeroSection from '@/components/sections/HeroSection.astro';
import ReviewBadge from '@/components/ui/ReviewBadge.astro';
import CategoryIcon from '@/components/ui/CategoryIcon.astro';
import UserReviews from '@/components/sections/UserReviews.astro';
import PhotoGrid from '@/components/sections/PhotoGrid.astro';
import OurStorySection from '@/components/sections/OurStorySection.astro';
import FaqAccordion from '@/components/sections/FaqAccordion.astro';
import MapEmbed from '@/components/ui/MapEmbed.astro';
import Footer from '@/components/layout/Footer.astro';
import { getCollection } from 'astro:content';
import { settings as siteSettings, phoneHref, absoluteUrl, hours as parsedHours } from '@/lib/site';
import { formatHoursSummary, toClientHours } from '@/lib/hours';
import { faqNode } from '@/lib/seo/graph';

const { address_line1, city, postal_code, phone } = siteSettings;

/**
 * Pre-JS fallback for the "today" hours widget below: this page is statically
 * prerendered, so the visitor's actual "today" isn't knowable at build time.
 * Rather than assert one (likely wrong) day, render the whole week grouped by
 * identical hours — always factually correct — and let the client script narrow
 * it to "Heute: …" once it knows the local day.
 *
 * Both this summary and the JSON-LD `openingHoursSpecification` come from the
 * same `src/lib/hours.ts` parse, so the visible text and the machine-readable
 * hours cannot drift apart.
 */
const hoursSummary = formatHoursSummary(parsedHours);

/**
 * Payload for the widget. Carries day INDEXES, not German day names: the old
 * script matched `Intl.DateTimeFormat('de-AT', {weekday:'long'})` output against
 * the CMS labels as raw strings, which silently produced nothing as soon as the
 * formatting locale wasn't German.
 */
const clientHours = toClientHours(parsedHours);

/**
 * HOME PAGE — D'ouro Soulfood Bistro
 */

/** 6 Core Category Slots for Homepage */
const categorySlots = [
  { slug: 'appetizers', title: 'Vorspeisen / Entradas', desc: 'Coxinha, Pão de Queijo & Ceviche', icon: 'appetizers' },
  { slug: 'quesadillas', title: 'Quesadillas', desc: 'Melted Gouda & Mozzarella-Mix', icon: 'quesadillas' },
  { slug: 'tacos', title: 'Tacos', desc: 'Picanha, Pollo, Vegano & Gambas', icon: 'tacos' },
  { slug: 'bowls', title: 'Bowls', desc: 'Brazil Beef, Chipotle & Surf & Turf', icon: 'bowls' },
  { slug: 'mains', title: 'Pratos Feitos', desc: 'Feijoada & African Peanut Stew mit Fufu', icon: 'mains' },
  { slug: 'drinks', title: 'Bebidas & Sobremesas', desc: 'Caipirinha, Guaraná & Brigadeiros', icon: 'drinks' },
];

/** 9 Popular dishes photos (image-only gallery layout). width/height match the actual source files (300×300). */
const popularDishes = [
  { src: '/images/menu/taco-especial.webp', alt: 'Taco Especial', width: 300, height: 300 },
  { src: '/images/menu/quesadilla-haehnchen.webp', alt: 'Quesadilla Hähnchen', width: 300, height: 300 },
  { src: '/images/menu/feijoada.webp', alt: 'Feijoada Brasileira', width: 300, height: 300 },
  { src: '/images/menu/pao-de-queijo.webp', alt: 'Pão de Queijo', width: 300, height: 300 },
  { src: '/images/menu/mango-ceviche.webp', alt: 'Mango Ceviche', width: 300, height: 300 },
  { src: '/images/menu/coxinha.webp', alt: 'Coxinha', width: 300, height: 300 },
  { src: '/images/menu/african-stew.webp', alt: 'African Peanut Stew', width: 300, height: 300 },
  { src: '/images/menu/brigadeiros.webp', alt: 'Brigadeiros', width: 300, height: 300 },
  { src: '/images/menu/brisa-do-mar.webp', alt: 'Brisa do Mar', width: 300, height: 300 },
];

/**
 * 9 Photos for Galerie section. width/height match each source file's actual
 * dimensions.
 *
 * Alt text describes what each photo actually shows, verified by opening the
 * files. They were previously alt'd "D'ouro Bistro Spezialität 1…9", which was
 * both useless to screen readers and factually wrong — most of these are
 * interior/exterior atmosphere shots, not dishes.
 */
const galleryImages = [
  { src: '/images/gallery/1.webp', alt: 'Gastraum des D\'ouro mit Fahrrad-Tisch, bunt gemusterten Kissen auf der Fensterbank und Orchidee', width: 680, height: 510 },
  { src: '/images/gallery/2.webp', alt: 'Gäste an einem Holztisch im D\'ouro, davor bunte Getränkeflaschen und ein Weinregal', width: 594, height: 510 },
  { src: '/images/gallery/3.webp', alt: 'Drei Tacos mit Guacamole auf schwarzer Platte, daneben ein grüner Cocktail', width: 382, height: 510 },
  { src: '/images/gallery/4.webp', alt: 'Paella mit Garnelen, Muscheln und Paprika in der Pfanne, dazu ein Beilagenteller', width: 382, height: 510 },
  { src: '/images/gallery/5.webp', alt: 'In der offenen Küche des D\'ouro wird frisch gekocht, mit brasilianischer Flagge auf der Kochmütze', width: 382, height: 510 },
  { src: '/images/gallery/6.webp', alt: 'Fensterbank mit bunten Patchwork-Kissen und Pflanzen, Blick auf die Salzburger Straße', width: 382, height: 510 },
  { src: '/images/gallery/7.webp', alt: 'Tisch am Fenster mit Palme und Blick auf die Salzburger Altbaufassaden', width: 382, height: 510 },
  { src: '/images/gallery/8.webp', alt: 'Außenansicht: das Schild „D\'ouro Soul Food“ über dem Eingang in der Auerspergstraße', width: 382, height: 510 },
  { src: '/images/gallery/9.webp', alt: 'Weinregal im D\'ouro mit Flaschen aus Chile und Portugal', width: 680, height: 510 },
];

/** FAQ entries from KeystaticCMS */
const faqEntries = (await getCollection('faq'))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const faqItems = faqEntries.map((item) => ({
  question: item.data.question,
  answer: item.data.answer,
}));

// SEO CONFIG
// No `canonical` override here on purpose. Base.astro defaults it to
// Astro.url.href, which under build.format:'directory' yields the trailing-slash
// form `https://douro-soulfood.com/` — the same form the sitemap's <loc> and the
// JSON-LD `url` already emit. Hand-setting the slashless variant here used to
// make one page advertise three different URLs for itself.
const PAGE_TITLE = "Afro-Lateinamerikanische Küche in Salzburg";
const PAGE_DESCRIPTION =
  "Frische brasilianische & afrikanische Soulfood-Spezialitäten von Angela in Salzburg. Tacos, Bowls, Feijoada & afrikanische Gerichte. Auerspergstraße 10.";
---

<Base
  title={PAGE_TITLE}
  description={PAGE_DESCRIPTION}
  extraSchemaNodes={[faqNode(faqItems, absoluteUrl('/', Astro.site))]}
>
  {/*
    Preload the hero poster — it is the homepage's largest above-the-fold paint,
    but as a `poster` attribute on a <video> it is otherwise not discovered
    until the parser reaches that element, well after the stylesheet request.
    One file, matching HeroSection's shared `poster` default (see the comment
    on that prop for why it's one file, not one per viewport).
  */}
  <Fragment slot="head">
    <link rel="preload" as="image" type="image/webp" href="/images/hero-fallback-1280.webp" />
  </Fragment>

  {/* 1. NAVBAR */}
  <NavBar slot="nav" />

  {/* 2. HERO SECTION */}
  <HeroSection
    accent="D'ouro Soulfood Bistro"
    headline="Afro-Latin Soul im Herzen von Salzburg"
    subheadline="Frische, handgemachte brasilianische & afrikanische Spezialitäten von Angela"
    images={[
      {
        src: '/images/hero-fallback.jpg',
        alt: "D'ouro Soulfood Bistro — Afro-Lateinamerikanische Küche in Salzburg",
        width: 1600,
        height: 900,
      },
    ]}
    ctaPrimary={{ label: 'Besuchen Sie uns', href: '/contact' }}
    ctaSecondary={{ label: 'Speisekarte ansehen', href: '/menu' }}
  />

  {/* 3. REVIEW BADGE */}
  <section class="py-section-mobile md:py-5 px-4 md:px-16 border-b border-border-subtle" aria-label="Bewertungen">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-center gap-4">
      <ReviewBadge
        rating={4.8}
        reviewCount={978}
        source="Google Reviews"
        href="https://www.google.com/maps/search/?api=1&query=Auerspergstra%C3%9Fe+10%2C+5020+Salzburg%2C+Austria"
        size="lg"
      />
      <span class="text-text-tertiary text-sm">Google Reviews</span>
    </div>
  </section>

  {/* 3b. QUICK-ACCESS ROW — fast access to menu/reservation/events/location,
       consolidated into one scannable block (priority: fast access to menu,
       ordering, reservation, events, and location). */}
  <section class="py-section-mobile md:py-5 px-4 md:px-16 max-w-7xl mx-auto" aria-label="Schnellzugriff">
    <div class="grid grid-cols-4 gap-2 sm:gap-4">
      {[
        {
          label: 'Speisekarte',
          href: '/menu',
          icon: 'M4 6h16M4 12h16M4 18h7',
        },
        {
          label: 'Reservieren',
          href: '/contact',
          icon: 'M8 2v4M16 2v4M3 10h18M5 6h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z',
        },
        {
          label: 'Events',
          href: '/catering',
          icon: 'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75',
        },
        {
          label: 'Standort',
          href: '#standort',
          icon: 'M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0zM12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6z',
        },
      ].map((item) => (
        <a
          href={item.href}
          class="group flex flex-col items-center gap-1.5 rounded-lg sm:rounded-2xl bg-surface-card border border-border-subtle hover:border-brand-gold/50 hover:bg-surface-elevated transition-all duration-[var(--duration-fast)] no-underline shadow-sm p-3 sm:p-4 min-h-12"
        >
          <svg
            class="w-5 h-5 sm:w-6 sm:h-6 text-brand-gold shrink-0"
            viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d={item.icon} />
          </svg>
          <span class="text-xs sm:text-sm font-semibold text-text-primary group-hover:text-brand-gold-ink text-center leading-tight">
            {item.label}
          </span>
        </a>
      ))}
    </div>
  </section>

  {/* 4. BELIEBTE GERICHTE IM D'OURO BISTRO — moved up: strongest appetite-appeal
       asset shouldn't be buried several sections deep. */}
  <PhotoGrid
    ariaLabel="Beliebte Gerichte"
    eyebrow="Empfehlungen"
    title="Beliebte Gerichte im D'ouro Bistro"
    description="Frisch von Angela zubereitet — mit den besten Zutaten Brasiliens und Westafrikas."
    items={popularDishes}
    cta={{ label: 'Komplette Speisekarte ansehen', href: '/menu' }}
  />

  {/* 5. WIE D'OURO BEGANN */}
  <OurStorySection
    ariaLabel="Unsere Geschichte"
    eyebrow="Unsere Geschichte"
    title="Wie D'ouro begann"
    text="D'ouro begann während des Lockdowns, als Angela von zu Hause aus selbstgemachtes brasilianisches Essen an alle verteilte, die ein Stück Heimat suchten. Genau diese Wärme und Leidenschaft stecken auch heute in jedem einzelnen Gericht."
    founderName="Angela"
    founderTitle="Gründerin & Chefköchin"
  />

  {/* 6. TESTIMONIALS — grouped near Story rather than split by two event-CTA
       sections. Rendered directly (no wrapping <section>) since
       UserReviews.astro's own root is already a full section with its own
       aria-label landmark and py-section-mobile padding — an outer wrapper
       here previously double-padded this section (96px combined gap vs
       64px everywhere else), caught by a 2026-08-08 browser-measured
       audit. Matches how PhotoGrid/OurStorySection/FaqAccordion are
       already invoked below. */}
  <UserReviews />

  {/* 7. 6 AFRO-LATINO SPEZIALITÄTEN — moved down: now a browse aid, the
       quick-access row above is the primary fast-access mechanism. */}
  <section class="py-section-mobile md:py-5 px-4 md:px-16 max-w-7xl mx-auto" aria-label="Speisekarte Kategorien">
    <div class="text-center mb-4 md:mb-5">
      <span class="inline-block text-xs md:text-sm font-semibold text-brand-gold-ink uppercase tracking-wider mb-1">
        Unsere Speisekarte
      </span>
      <h2 class="text-2xl md:text-3xl font-extrabold text-text-primary font-display uppercase tracking-tight">
        Entdecken Sie unsere 6 Afro-Latino Spezialitäten
      </h2>
    </div>

    <div class="grid grid-cols-6 gap-1 sm:gap-3 md:gap-4">
      {categorySlots.map((slot) => (
        <a
          href={`/menu#category-${slot.slug}`}
          class="group flex flex-col items-center text-center p-1.5 sm:p-4 rounded-lg sm:rounded-2xl bg-surface-card border border-border-subtle hover:border-brand-gold/50 hover:bg-surface-elevated transition-all duration-[var(--duration-fast)] no-underline shadow-sm sm:shadow-md min-w-0"
        >
          <div class="w-7 h-7 sm:w-12 sm:h-12 rounded-md sm:rounded-xl bg-brand-gold/15 text-brand-gold flex items-center justify-center mb-1 sm:mb-3 group-hover:scale-110 transition-transform shrink-0">
            <CategoryIcon name={slot.icon} class="w-3.5 h-3.5 sm:w-6 sm:h-6" />
          </div>
          <h3 class="text-xs sm:text-sm font-bold text-text-primary group-hover:text-brand-gold-ink font-display transition-colors leading-tight mb-0.5 sm:mb-1 line-clamp-2 break-words min-h-[2.2em] sm:min-h-[2.4em] w-full">
            {slot.title.split('/')[0]}
          </h3>
          <p class="hidden sm:block text-xs text-text-tertiary leading-tight line-clamp-2">
            {slot.desc}
          </p>
        </a>
      ))}
    </div>
  </section>

  {/* 8. EVENTS & FEIERN — Firmenevents + Private Feiern consolidated into one
       section (two cards) instead of two separate full-width sections;
       shorter scroll, same content. */}
  <section class="py-section-mobile md:py-5 px-4 md:px-16 max-w-7xl mx-auto" aria-label="Events & Feiern">
    <div class="text-center mb-4 md:mb-5">
      <span class="inline-block text-xs md:text-sm font-semibold text-brand-gold-ink uppercase tracking-wider mb-1">
        Feiern & Events
      </span>
      <h2 class="text-2xl md:text-3xl font-semibold text-text-primary font-display">
        Für jeden Anlass das Richtige
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-6">
      {[
        {
          title: 'Firmenevents',
          description: 'Von Team-Lunches bis Firmenfeiern — unsere Catering-Pakete passen sich Ihren Bedürfnissen an.',
          image: { src: '/images/catering/event.webp', alt: 'Firmenevent Catering', width: 800, height: 600 },
          cta: { label: 'Anfrage senden', href: '/contact' },
        },
        {
          title: 'Private Feiern',
          description: 'Geburtstage, Hochzeiten, Familientreffen — wir bringen Soul Food direkt zu Ihnen.',
          image: { src: '/images/catering/private.webp', alt: 'Private Feiern Catering', width: 800, height: 600 },
          cta: { label: 'Jetzt planen', href: '/contact' },
        },
      ].map((item) => (
        <div class="flex flex-col rounded-lg overflow-hidden glass shadow-md">
          <Image
            src={item.image.src}
            alt={item.image.alt}
            width={item.image.width}
            height={item.image.height}
            format="webp"
            quality={85}
            class="w-full aspect-[4/3] object-cover"
            loading="lazy"
          />
          <div class="flex flex-col gap-3 p-5 md:p-6">
            <h3 class="text-xl font-semibold text-text-primary font-display">{item.title}</h3>
            <p class="text-base text-text-secondary leading-relaxed">{item.description}</p>
            <Button href={item.cta.href} variant="primary" size="sm" class="w-fit">
              {item.cta.label}
            </Button>
          </div>
        </div>
      ))}
    </div>
  </section>

  {/* 9. GALERIE SECTION */}
  <PhotoGrid
    ariaLabel="Galerie"
    eyebrow="Impressionen"
    title="Galerie"
    description="Einblicke in unsere frischen Speisen und das Ambiente im D'ouro Bistro."
    items={galleryImages}
  />

  {/* 10. FAQ ACCORDION */}
  <FaqAccordion
    ariaLabel="Häufig gestellte Fragen"
    eyebrow="FAQ"
    title="Häufig gestellte Fragen"
    items={faqItems}
  />

  {/* 11. MAP & STANDORT SECTION */}
  <section id="standort" class="py-section-mobile md:py-5 px-4 md:px-16 max-w-7xl mx-auto" aria-label="Unser Standort">
    <div class="text-center mb-4 md:mb-5">
      <span class="inline-block text-xs md:text-sm font-semibold text-brand-gold-ink uppercase tracking-wider mb-1">
        Standort
      </span>
      <h2 class="text-2xl md:text-3xl font-semibold text-text-primary font-display">
        Unser Bistro in Salzburg
      </h2>
    </div>

    <article class="rounded-lg overflow-hidden bg-surface-glass backdrop-blur-sm border border-border-subtle shadow-md">
      <div class="flex flex-col md:flex-row">
        {/* Map (consent-gated: real iframe only loads after visitor clicks through) */}
        <div class="w-full md:w-1/2 min-h-[260px] md:min-h-[340px]">
          <MapEmbed
            src="https://maps.google.com/maps?q=Auerspergstra%C3%9Fe%2010,%205020%20Salzburg&t=&z=15&ie=UTF8&iwloc=&output=embed"
            title="D'ouro Soulfood Standort"
            addressLabel="Auerspergstraße 10, 5020 Salzburg"
            class="min-h-[260px] md:min-h-[340px]"
          />
        </div>

        {/* Details */}
        <div class="flex flex-col flex-1 justify-between gap-4 p-5 md:p-8">
          <div class="flex flex-col gap-3">
            <div>
              <span class="text-xs uppercase font-semibold tracking-wider text-brand-gold-ink">Restaurant & Bistro</span>
              <h3 class="text-xl md:text-2xl font-bold text-text-primary font-display mt-0.5">
                Salzburg, Österreich
              </h3>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="flex flex-col gap-0.5">
                <span class="text-[11px] text-text-tertiary uppercase font-medium">Adresse</span>
                <address class="not-italic text-xs md:text-sm text-text-secondary leading-relaxed">
                  <p>{address_line1}</p>
                  <p>{postal_code} {city}</p>
                </address>
              </div>
              <div class="flex flex-col gap-0.5">
                <span class="text-[11px] text-text-tertiary uppercase font-medium">Kontakt</span>
                <a
                  href={phoneHref}
                  class="text-xs md:text-sm text-text-secondary hover:text-brand-gold-ink no-underline transition-colors"
                >
                  {phone}
                </a>
              </div>
            </div>
          </div>

          <div class="border-t border-border-subtle pt-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
            <div>
              <span class="text-[11px] text-text-tertiary block">Öffnungszeiten</span>
              <span
                id="today-hours"
                data-hours={JSON.stringify(clientHours)}
                data-tpl-open="Heute: {time} Uhr"
                data-tpl-closed="Heute geschlossen"
                class="text-xs md:text-sm font-medium text-text-primary"
              >
                {hoursSummary}
              </span>
            </div>
            <Button href="/menu" variant="primary" size="sm" class="shadow-glow-gold">
              Jetzt bestellen
            </Button>
          </div>
        </div>
      </div>
    </article>
  </section>

  {/* 12. FOOTER */}
  <Footer slot="footer" />
</Base>

<script>
  // Narrows the server-rendered week summary to just today's hours.
  //
  // Deliberately contains NO human-readable strings: the labels arrive via
  // data-tpl-* and the day is resolved by INDEX, not by matching a localized
  // weekday name against the CMS labels (which is what silently broke before).
  // Keeping this script string-free means it stays byte-identical no matter what
  // language the page is in — so adding a locale costs zero extra CSP hashes.
  const el = document.getElementById('today-hours');

  if (el) {
    const hours: { d: number; closed: boolean; time: string }[] = JSON.parse(el.dataset.hours ?? '[]');

    // 'en-US' short weekday is a stable, locale-independent key. The timeZone
    // stays Europe/Vienna on purpose: the relevant "today" is the restaurant's,
    // not the visitor's.
    const code = new Intl.DateTimeFormat('en-US', {
      timeZone: 'Europe/Vienna',
      weekday: 'short',
    }).format(new Date());

    const ISO_DAY: Record<string, number> = {
      Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6, Sun: 7,
    };

    const entry = hours.find((h) => h.d === ISO_DAY[code]);

    if (entry) {
      el.textContent = entry.closed
        ? (el.dataset.tplClosed ?? el.textContent)
        : (el.dataset.tplOpen ?? '').replace('{time}', entry.time);
    }
  }
</script>
