---
export const prerender = true;

import Base from '@/layouts/Base.astro';
import NavBar from '@/components/layout/NavBar.astro';
import Footer from '@/components/layout/Footer.astro';
import FeatureCard from '@/components/sections/FeatureCard.astro';
---

<Base
  title="Catering & Events"
  description="Catering von D'ouro Soulfood in Salzburg: von Team-Lunches und Firmenfeiern bis zu Geburtstagen, Hochzeiten und Familientreffen — brasilianisches und afrikanisches Soul Food direkt zu Ihrem Event."
  breadcrumb={[{ name: 'Catering & Events', path: '/catering/' }]}
>
  <NavBar slot="nav" />

  <section class="pt-28 md:pt-32 pb-16 md:pb-24 px-4 md:px-16 max-w-7xl mx-auto">
    <h1 class="text-[clamp(2rem,4vw,3rem)] font-bold text-brand-gold-ink mb-4 font-display break-words">Catering & Events</h1>
    <p class="text-text-secondary max-w-[52ch] leading-relaxed mb-12">
      Bringen Sie den Geschmack von D'ouro zu Ihrem nächsten Event.
      Von Firmenfeiern bis privaten Feiern — wir liefern Soul Food direkt zu Ihnen.
    </p>
  </section>

  <FeatureCard
    title="Firmenevents"
    description="Von Team-Lunches bis Firmenfeieren — unsere Catering-Pakete passen sich Ihren Bedürfnissen an."
    image={{ src: '/images/catering/event.webp', alt: 'Firmenevent Catering', width: 800, height: 600 }}
    cta={{ label: 'Anfrage senden', href: '/contact' }}
  />

  <FeatureCard
    title="Private Feiern"
    description="Geburtstage, Hochzeiten, Familientreffen — wir bringen Soul Food direkt zu Ihnen."
    image={{ src: '/images/catering/private.webp', alt: 'Private Feiern Catering', width: 800, height: 600 }}
    cta={{ label: 'Jetzt planen', href: '/contact' }}
    reverse
  />

  <Footer slot="footer" />
</Base>
