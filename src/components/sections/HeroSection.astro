---

/**
 * HeroSection — Full-bleed hero with background image carousel,
 * headline overlay, and dual CTA buttons.
 *
 * Slot composition: Use <slot /> for any additional hero content
 * (e.g. scroll indicator, trust badges).
 *
 * Tokens: brand-gold, brand-espresso, surface-primary, text-primary.
 * Zero hex codes. All colors from tokens.css @theme.
 */

import Button from '@/components/ui/Button.astro';

interface HeroImage {
  src: string;
  alt: string;
  width: number;
  height: number;
}

interface Props {
  /** Small accent headline — rendered in brand gold */
  accent: string;
  /** Main hero headline — rendered in display font */
  headline: string;
  /** Supporting subheadline text */
  subheadline?: string;
  /** Hero background video URL (e.g. /douroherovideo.mp4) — desktop/tablet */
  videoSrc?: string;
  /** Hero background video URL — mobile (smaller file, different crop) */
  videoSrcMobile?: string;
  /** Hero background images (fallback source) */
  images?: HeroImage[];
  /**
   * Poster frame shown before/instead of the video. ONE file, deliberately
   * shared by both the mobile and desktop <video> elements.
   *
   * `poster` must stay a real, static HTML attribute — it's what a no-JS
   * visitor sees permanently, and what everyone sees during the gap before the
   * viewport-detection script (below) runs, so it can't be assigned by that
   * script the way `src` is. But `<video>` has no `srcset`, and since a static
   * attribute is parsed before any CSS applies, giving each viewport's video
   * its OWN poster means BOTH get fetched unconditionally regardless of which
   * one is visually hidden — this repo already hit that exact class of bug for
   * `src` (see the comment on the <video> tags below) and it recurs here
   * because `poster` has no script-mediated equivalent. One right-sized WebP
   * (1280w, 55 KB — replacing what was a 1600x900, 178 KB JPEG served
   * unchanged to a 375px phone) costs one fetch either way, so sharing it is a
   * straight improvement over two viewport-specific files that both load.
   */
  poster?: string;
  /** Primary CTA config */
  ctaPrimary: { label: string; href: string };
  /** Secondary CTA config */
  ctaSecondary?: { label: string; href: string };
}

const {
  accent,
  headline,
  subheadline,
  videoSrc = '/douroherovideo.mp4',
  videoSrcMobile = '/douroheromobile.mp4',
  images = [],
  poster = '/images/hero-fallback-1280.webp',
  ctaPrimary,
  ctaSecondary,
} = Astro.props;

/** Use first image as fallback hero background */
const heroImage = images[0];
---

<header class="relative w-full overflow-hidden bg-surface-primary">
  <!-- Background layer (Video or Image) -->
  <div
    class="absolute inset-0 overflow-hidden"
    role="region"
    aria-live="polite"
    aria-atomic="true"
    aria-label="Hero-Hintergrund"
  >
    {videoSrc ? (
      <>
        {/* Mobile and desktop videos share a poster fallback and load lazily —
            see the script below. Neither has a static `src`/`autoplay`: both
            browsers otherwise start fetching BOTH files regardless of which
            is actually visible (CSS `hidden`/`block` only affects rendering,
            not resource loading), doubling real bandwidth cost on every
            visit. The script sets `src` only on the video matching the
            current viewport, and skips playback entirely for visitors who
            prefer reduced motion — the poster then stays visible instead. */}
        <!-- Mobile Video -->
        <video
          data-hero-video="mobile"
          data-video-src={videoSrcMobile}
          poster={poster}
          loop
          muted
          playsinline
          preload="none"
          class="block md:hidden absolute inset-0 w-full h-full object-cover object-center pointer-events-none"
        ></video>
        <!-- Desktop Video -->
        <video
          data-hero-video="desktop"
          data-video-src={videoSrc}
          poster={poster}
          loop
          muted
          playsinline
          preload="none"
          class="hidden md:block absolute inset-0 w-full h-full object-cover object-center pointer-events-none"
        ></video>
      </>
    ) : heroImage && (
      <img
        src={heroImage.src}
        alt={heroImage.alt}
        width={heroImage.width}
        height={heroImage.height}
        class="absolute inset-0 w-full h-full object-cover object-center"
        loading="eager"
      />
    )}
    <!-- Gradient overlay: dark overlay for text contrast -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/40 to-black/60"></div>
  </div>

  <!-- Hero content: 100vh full-screen on mobile, text shifted significantly higher -->
  <div class="relative max-w-7xl mx-auto px-4 md:px-16 min-h-screen min-h-[100svh] flex flex-col justify-end pb-48 md:pb-16">
    <div class="flex flex-col gap-3 lg:gap-4 max-w-2xl">
      <!-- Accent label — brand gold decorative text -->
      <span class="text-xs md:text-xl lg:text-2xl font-semibold text-brand-gold leading-tight tracking-tight font-display">
        {accent}
      </span>

      <!-- Main headline — white text for contrast, semantically h1 for SEO -->
      <h1 class="text-3xl md:text-5xl lg:text-6xl font-semibold text-white leading-tight font-display">
        {headline}
      </h1>

      {subheadline && (
        <p class="text-base md:text-lg text-white/90 max-w-[52ch] leading-relaxed">
          {subheadline}
        </p>
      )}

      <!-- Desktop CTA buttons (Hidden on Mobile per reference layout) -->
      <div class="hidden md:flex flex-wrap gap-3 mt-4">
        <!-- Primary CTA — brand gold with glow -->
        <a
          href={ctaPrimary.href}
          class="group inline-flex items-center gap-2 min-h-12 px-5 py-3 text-base font-semibold
                 rounded-sm bg-brand-gold hover:bg-brand-gold-light active:bg-brand-gold-dark text-brand-espresso
                 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold
                 no-underline transition-colors duration-[var(--duration-fast)] ease-[var(--ease-spring)] shadow-glow-gold"
        >
          <span class="flex items-center gap-1 whitespace-nowrap">{ctaPrimary.label}</span>
          <svg
            class="w-4 h-4 opacity-50 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all duration-[var(--duration-fast)] ease-[var(--ease-spring)]"
            viewBox="0 0 256 256" fill="none" stroke="currentColor"
            stroke-width="24" stroke-linecap="round" stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="70" y1="128" x2="216" y2="128" />
            <polyline points="144 56 216 128 144 200" />
          </svg>
        </a>

        {ctaSecondary && (
          <!-- Secondary CTA — outlined style -->
          <a
            href={ctaSecondary.href}
            class="inline-flex items-center gap-2 min-h-12 px-5 py-3 text-base font-medium
                   rounded-sm border border-border-default bg-surface-elevated
                   hover:bg-surface-card hover:border-border-emphasis hover:text-text-primary
                   active:bg-surface-primary
                   focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold
                   text-text-secondary no-underline transition-colors duration-[var(--duration-fast)] ease-[var(--ease-spring)]"
          >
            {ctaSecondary.label}
          </a>
        )}
      </div>

      <!-- Mobile CTA: one dominant primary action. Complements MobileBottomBar's
           Call/Order pair rather than duplicating it — this surfaces the menu,
           the one common next step those two buttons don't cover. -->
      {ctaSecondary && (
        <div class="flex md:hidden mt-4">
          <Button href={ctaSecondary.href} variant="primary" size="lg" arrow class="w-full justify-center shadow-glow-gold">
            {ctaSecondary.label}
          </Button>
        </div>
      )}
    </div>

    <!-- Slot for additional hero content (scroll indicator, badges, etc.) -->
    <slot />
  </div>
</header>

<script>
  // Loads and plays only the hero video matching the current viewport —
  // see the comment above the <video> tags for why this can't be left to
  // CSS alone. Also respects prefers-reduced-motion: if set, no video is
  // loaded at all and the poster image stays visible (WCAG 2.2.2 — this
  // background video is purely decorative, loops indefinitely, and has no
  // pause control, so it must not autoplay for users who've asked for
  // reduced motion). Autoplay can still fail even when allowed (iOS/macOS
  // Safari Low Power Mode blocks it unconditionally, with no way to detect
  // or work around this) — .play()'s rejection is caught silently and the
  // poster remains visible, which is the correct fallback.
  const videos = document.querySelectorAll<HTMLVideoElement>('[data-hero-video]');
  if (videos.length > 0) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const desktopQuery = window.matchMedia('(min-width: 768px)');

    let activeVideo: HTMLVideoElement | null = null;

    const activate = () => {
      if (reduceMotion.matches) return;

      const wantDesktop = desktopQuery.matches;
      const next = document.querySelector<HTMLVideoElement>(
        `[data-hero-video="${wantDesktop ? 'desktop' : 'mobile'}"]`
      );
      if (!next || next === activeVideo) return;

      if (activeVideo) {
        activeVideo.pause();
        activeVideo.removeAttribute('src');
        activeVideo.load();
      }

      const src = next.dataset.videoSrc;
      if (src) {
        next.src = src;
        next.load();
        next.play().catch(() => {
          // Autoplay rejected (Low Power Mode, restrictive in-app browser,
          // data-saver mode, etc.) — poster image stays visible, no error.
        });
      }
      activeVideo = next;
    };

    activate();
    desktopQuery.addEventListener('change', activate);
    reduceMotion.addEventListener('change', activate);
  }
</script>
