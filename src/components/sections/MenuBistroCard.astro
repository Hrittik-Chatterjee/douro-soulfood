---
import { Image } from 'astro:assets';
import FlagIcon from '@/components/ui/FlagIcon.astro';
import { orderUrl as orderHref } from '@/lib/site';

interface Props {
  name: string;
  description: string;
  descriptionEn?: string;
  priceInCents: number;
  priceVariants?: { nonAlcoholic?: number; alcoholic?: number };
  prepTime?: string;
  prepTimeEn?: string;
  allergens?: string[];
  addOns?: { label: string; price: number }[];
  imageSrc?: string;
  imageAlt?: string;
  available?: boolean;
  class?: string;
}

const {
  name,
  description,
  descriptionEn,
  priceInCents,
  priceVariants,
  prepTime,
  prepTimeEn,
  allergens = [],
  addOns = [],
  imageSrc,
  imageAlt = '',
  available = true,
  class: className = '',
} = Astro.props;

/** Format price from cents to EUR display string e.g. €8,90 */
const formatPrice = (cents: number): string => {
  const euros = cents / 100;
  return new Intl.NumberFormat('de-DE', {
    style: 'currency',
    currency: 'EUR',
    minimumFractionDigits: 2,
  }).format(euros);
};

const formattedPrice = formatPrice(priceInCents);

/** Dual price display for items with alcoholic/non-alcoholic variants */
const hasDualPrice = priceVariants?.nonAlcoholic !== undefined && priceVariants?.alcoholic !== undefined;
const dualPriceDisplay = hasDualPrice
  ? `${formatPrice(priceVariants!.nonAlcoholic!)} / ${formatPrice(priceVariants!.alcoholic!)}`
  : null;

/** Allergen code display format: (A, M) */
const allergenString = allergens.length > 0 ? `(${allergens.join(', ')})` : '';
---

<article
  class:list={[
    'group relative flex flex-row justify-between items-start md:items-center rounded-sm p-3.5 sm:p-4 md:p-4 bg-(--color-bistro-paper) border border-(--color-bistro-paper-border) shadow-sm hover:shadow-md hover:border-(--color-bistro-taupe) transition-all duration-200 gap-3.5 sm:gap-4 md:gap-5 overflow-hidden w-full max-w-full',
    !available && 'opacity-60',
    className,
  ]}
>
  {/* Entire Card Clickable Link */}
  <a
    href={orderHref}
    target="_blank"
    rel="noopener noreferrer"
    class="absolute inset-0 z-20 rounded-sm focus:outline-none focus:ring-2 focus:ring-amber-600"
    aria-label={`Jetzt ${name} bestellen`}
  ></a>

  {/* Image Column — Mobile (< md): Right side (order-2, w-24 h-24). Desktop (>= md): Left side (md:order-1, md:w-36 md:h-36 lg:w-40 lg:h-40) */}
  {imageSrc && (
    <div class="w-24 h-24 sm:w-28 sm:h-28 md:w-36 md:h-36 lg:w-40 lg:h-40 shrink-0 aspect-square rounded-md overflow-hidden relative shadow-inner bg-(--color-bistro-placeholder) self-start md:self-center order-2 md:order-1">
      <Image
        src={imageSrc}
        alt={imageAlt || name}
        width={400}
        height={400}
        format="webp"
        quality={85}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 ease-out"
        loading="lazy"
      />
    </div>
  )}

  {/* Details Column — Mobile (< md): Left side (order-1). Desktop (>= md): Right side (md:order-2) */}
  <div class="flex flex-col justify-center flex-1 py-0.5 md:py-1 min-w-0 gap-1.5 sm:gap-2 self-start md:self-center w-full order-1 md:order-2">
    <div>
      {/* Title + Highlighted Price Header */}
      <div class="flex items-center justify-between gap-2 w-full mb-2">
        <h3 class="text-sm sm:text-base md:text-lg font-serif font-black text-(--color-bistro-ink) tracking-wide uppercase break-words leading-snug min-w-0 flex-1 self-center">
          {name}
        </h3>

        {/* Highlighted Price Badge — dual or single */}
        {hasDualPrice ? (
          <div class="shrink-0 flex flex-col items-end gap-1 ml-1 self-center">
            <div class="font-serif font-extrabold text-(--color-bistro-banner-text) bg-(--color-bistro-banner) border border-(--color-bistro-banner-border)/50 px-3 py-1 rounded-sm shadow-xs text-sm sm:text-base tracking-wide whitespace-nowrap">
              {dualPriceDisplay}
            </div>
            <div class="flex flex-col items-end gap-0.5">
              <div class="flex items-center gap-1">
                <FlagIcon lang="de" class="w-3.5 h-2.5 rounded-[2px] shadow-xs" />
                <span class="text-[11px] text-(--color-bistro-muted) font-sans font-medium tracking-wide whitespace-nowrap">ohne / mit Alkohol</span>
              </div>
              <div class="flex items-center gap-1">
                <FlagIcon lang="uk" class="w-3.5 h-2.5 rounded-[2px] shadow-xs" />
                <span class="text-[11px] text-(--color-bistro-muted) font-sans font-medium tracking-wide whitespace-nowrap">non-alc. / alcoholic</span>
              </div>
            </div>
          </div>
        ) : (
          <div class="shrink-0 flex flex-col items-end ml-1 self-center">
            <div class="font-serif font-extrabold text-(--color-bistro-banner-text) bg-(--color-bistro-banner) border border-(--color-bistro-banner-border)/50 px-3 py-1 rounded-sm shadow-xs text-sm sm:text-base md:text-lg tracking-wide whitespace-nowrap">
              {formattedPrice}
            </div>
            {prepTime && (
              <span class="text-[11px] sm:text-xs text-(--color-bistro-muted) font-sans font-medium tracking-wide whitespace-nowrap mt-0.5">
                ⏱️ {prepTime}
              </span>
            )}
          </div>
        )}
      </div>

      {/* Language 1: German with SVG Flag */}
      {description && (
        <div class="flex items-start gap-1.5 sm:gap-2 mb-1.5 text-xs sm:text-sm text-(--color-bistro-text-strong) leading-snug">
          <FlagIcon lang="de" class="w-4 h-3 rounded-[2px] shadow-xs mt-0.5 sm:mt-1" />
          <p class="font-sans font-medium break-words min-w-0">{description}</p>
        </div>
      )}

      {/* Prep time in German if detailed */}
      {prepTime && (
        <div class="flex items-center gap-1.5 ml-5 sm:ml-6 mb-1.5 text-xs text-amber-900/90 italic">
          <span class="text-xs">⏱️</span>
          <span>Wartezeit ca. {prepTime}.</span>
        </div>
      )}

      {/* Language 2: English with SVG Flag */}
      {descriptionEn && (
        <div class="flex items-start gap-1.5 sm:gap-2 text-xs sm:text-sm text-(--color-bistro-muted-dark) leading-snug">
          <FlagIcon lang="uk" class="w-4 h-3 rounded-[2px] shadow-xs mt-0.5 sm:mt-1" />
          <p class="font-sans break-words min-w-0">{descriptionEn}</p>
        </div>
      )}

      {/* Prep time in English if detailed */}
      {prepTimeEn && (
        <div class="flex items-center gap-1.5 ml-5 sm:ml-6 mt-0.5 text-xs text-(--color-bistro-muted) italic">
          <span class="text-xs">⏱️</span>
          <span>Waiting time {prepTimeEn}.</span>
        </div>
      )}
      {/* Add-ons tag (e.g. + Frango (Chicken) + €3,00) */}
      {addOns.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-2">
          {addOns.map((addon) => (
            <span class="inline-flex items-center gap-1 text-xs font-semibold text-amber-950 bg-amber-100/90 border border-amber-900/20 px-2.5 py-0.5 rounded-lg shadow-xs">
              + {addon.label} (+{formatPrice(addon.price)})
            </span>
          ))}
        </div>
      )}
    </div>

    {/* Allergen Codes */}
    {allergens.length > 0 && (
      <div class="mt-1 pt-0.5 text-xs sm:text-sm font-serif font-bold text-amber-900">
        {allergenString}
      </div>
    )}
  </div>
</article>
