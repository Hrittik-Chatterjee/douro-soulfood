---
import { Image } from 'astro:assets';
import DietaryBadge from '@/components/ui/DietaryBadge.astro';
import AllergenBadge from '@/components/ui/AllergenBadge.astro';
import { orderUrl as orderHref } from '@/lib/site';

/**
 * MenuItemCard — Responsive card component for a single menu item.
 *
 * - If `imageSrc` is provided: Renders a full-bleed square glassmorphic photo card.
 * - If `imageSrc` is missing/null: Renders a clean, compact text-based menu card (no empty photo placeholders).
 */

type DietaryTag = 'vegan' | 'vegetarian' | 'gluten-free' | 'spicy' | 'halal' | 'dairy-free';

interface AddOn {
  label: string;
  price: number;
}

interface Props {
  name: string;
  description: string;
  priceInCents: number;
  dietary?: DietaryTag[];
  allergens?: string[];
  prepTime?: string;
  addOns?: AddOn[];
  priceVariants?: {
    nonAlcoholic?: number;
    alcoholic?: number;
  };
  available?: boolean;
  featured?: boolean;
  imageSrc?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  class?: string;
}

const {
  name,
  description,
  priceInCents,
  dietary = [],
  allergens = [],
  prepTime,
  addOns = [],
  priceVariants,
  available = true,
  featured = false,
  imageSrc,
  imageAlt = '',
  imageWidth = 400,
  imageHeight = 300,
  class: className = '',
} = Astro.props;

/** Format price from cents to EUR display string */
const formatPrice = (cents: number): string => {
  const euros = cents / 100;
  return new Intl.NumberFormat('de-AT', {
    style: 'currency',
    currency: 'EUR',
    minimumFractionDigits: 2,
  }).format(euros);
};

const displayPrice = priceVariants?.nonAlcoholic && priceVariants?.alcoholic
  ? `${formatPrice(priceVariants.nonAlcoholic)} / ${formatPrice(priceVariants.alcoholic)}`
  : formatPrice(priceInCents);
---

{imageSrc ? (
  /* ═══════════════════════════════════════════════════════
     1. FULL PHOTO CARD (When dish photo is available)
     ═══════════════════════════════════════════════════════ */
  <article
    class:list={[
      'group relative flex flex-col rounded-3xl overflow-hidden aspect-square w-full min-h-[320px]',
      'shadow-lg',
      'transition-all duration-[var(--duration-fast)] ease-[var(--ease-spring)] hover:shadow-xl hover:-translate-y-0.5',
      !available && 'opacity-60',
      className,
    ]}
  >
    {/* Entire Card Clickable Link */}
    <a href={orderHref} target="_blank" rel="noopener noreferrer" class="absolute inset-0 z-30" aria-label={`Jetzt ${name} bestellen`}></a>

    {/* Badges Overlay Container */}
    <div class="absolute top-3 inset-x-3 z-30 flex items-center justify-between pointer-events-none">
      {prepTime ? (
        <span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-bold rounded-full bg-black/75 text-amber-300 border border-amber-500/40 backdrop-blur-md">
          ⏱️ {prepTime}
        </span>
      ) : <div />}

      {featured && (
        <span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-semibold rounded-full bg-brand-gold/90 text-brand-espresso shadow-md backdrop-blur-xs font-display uppercase tracking-wider">
          <svg class="w-3 h-3 fill-current" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
          Empfehlung
        </span>
      )}
    </div>

    {/* Image Background */}
    <div class="absolute inset-0 z-0 bg-surface-card">
      <Image
        src={imageSrc}
        alt={imageAlt || name}
        width={imageWidth}
        height={imageHeight}
        format="webp"
        quality={85}
        class="w-full h-full object-cover transition-transform duration-[var(--duration-normal)] ease-[var(--ease-out-quart)] group-hover:scale-105"
        loading="lazy"
      />
    </div>

    {/* Gradient Overlay */}
    <div class="absolute inset-0 z-10 bg-gradient-to-t from-black/95 via-black/50 to-transparent pointer-events-none" />

    {/* Availability Banner */}
    {!available && (
      <div class="absolute inset-0 z-20 bg-surface-primary/70 flex items-center justify-center backdrop-blur-xs">
        <span class="text-sm font-semibold text-text-tertiary uppercase tracking-wider">Nicht verfügbar</span>
      </div>
    )}

    {/* Blurred Background with Progressive Fade */}
    <div
      class="absolute inset-x-0 bottom-0 h-[70%] backdrop-blur-md bg-black/40 pointer-events-none z-15 transition-colors duration-[var(--duration-fast)] ease-[var(--ease-spring)] group-hover:bg-black/50"
      style="mask-image: linear-gradient(to top, black 0%, rgba(0,0,0,0.95) 60%, transparent 100%); -webkit-mask-image: linear-gradient(to top, black 0%, rgba(0,0,0,0.95) 60%, transparent 100%);"
    ></div>

    {/* Content Panel */}
    <div class="relative z-20 mt-auto p-4 md:p-5 bg-transparent flex flex-col gap-2">
      <div class="flex items-start justify-between gap-3">
        <h3 class="text-base md:text-lg font-bold text-white group-hover:text-brand-gold transition-colors font-display leading-snug">
          {name}
        </h3>
        <span class="shrink-0 text-base md:text-lg font-bold text-brand-gold whitespace-nowrap bg-black/40 px-2 py-0.5 rounded-sm border border-brand-gold/30">
          {displayPrice}
        </span>
      </div>

      <p class="text-xs md:text-sm text-text-secondary leading-relaxed line-clamp-2" style="color: rgba(255, 255, 255, 0.85);">
        {description}
      </p>

      {addOns.length > 0 && (
        <div class="flex flex-wrap gap-1 mt-0.5">
          {addOns.map((addon) => (
            <span class="inline-flex items-center gap-1 text-[11px] font-medium text-brand-gold bg-brand-gold/15 px-2 py-0.5 rounded border border-brand-gold/30">
              + {addon.label} ({formatPrice(addon.price)})
            </span>
          ))}
        </div>
      )}

      {(dietary.length > 0 || allergens.length > 0) && (
        <div class="flex flex-wrap items-center gap-1.5 mt-1 pt-1 border-t border-white/10">
          {dietary.map((tag) => <DietaryBadge tag={tag} />)}
          {allergens.map((code) => <AllergenBadge code={code} />)}
        </div>
      )}
    </div>
  </article>
) : (
  /* ═══════════════════════════════════════════════════════
     2. TEXT-ONLY MENU CARD (Clean layout when no photo exists)
     ═══════════════════════════════════════════════════════ */
  <article
    class:list={[
      'group relative flex flex-col justify-between rounded-2xl p-5 w-full min-h-[170px]',
      'bg-surface-card border border-border-subtle shadow-md',
      'hover:border-brand-gold/40 hover:bg-surface-elevated hover:shadow-lg hover:-translate-y-0.5',
      'transition-all duration-[var(--duration-fast)] ease-[var(--ease-spring)]',
      !available && 'opacity-60',
      className,
    ]}
  >
    {/* Entire Card Clickable Link */}
    <a href={orderHref} target="_blank" rel="noopener noreferrer" class="absolute inset-0 z-30" aria-label={`Jetzt ${name} bestellen`}></a>

    {/* Top Row: Name + Price + Featured/Prep */}
    <div class="flex flex-col gap-2">
      <div class="flex items-start justify-between gap-3">
        <div class="flex flex-col gap-1">
          {featured && (
            <span class="inline-self-start inline-flex items-center gap-1 px-2 py-0.5 text-[11px] font-semibold rounded bg-brand-gold/20 text-brand-gold-ink border border-brand-gold/30 uppercase tracking-wider font-display">
              Empfehlung
            </span>
          )}
          <h3 class="text-base md:text-lg font-bold text-text-primary group-hover:text-brand-gold-ink transition-colors font-display leading-snug">
            {name}
          </h3>
        </div>

        <div class="flex flex-col items-end gap-1 shrink-0">
          <span class="text-base md:text-lg font-bold text-brand-gold-ink whitespace-nowrap px-2.5 py-1 rounded bg-surface-elevated border border-brand-gold/30">
            {displayPrice}
          </span>
          {prepTime && (
            <span class="text-[11px] font-medium text-amber-300/90">
              ⏱️ {prepTime}
            </span>
          )}
        </div>
      </div>

      {/* Description */}
      <p class="text-xs md:text-sm text-text-secondary leading-relaxed max-w-[52ch]">
        {description}
      </p>
    </div>

    {/* Bottom Row: Add-ons & Badges */}
    <div class="flex flex-col gap-2 mt-3 pt-3 border-t border-border-subtle/50">
      {addOns.length > 0 && (
        <div class="flex flex-wrap gap-1">
          {addOns.map((addon) => (
            <span class="inline-flex items-center gap-1 text-[11px] font-medium text-brand-gold-ink bg-brand-gold/15 px-2 py-0.5 rounded border border-brand-gold/30">
              + {addon.label} ({formatPrice(addon.price)})
            </span>
          ))}
        </div>
      )}

      {(dietary.length > 0 || allergens.length > 0) && (
        <div class="flex flex-wrap items-center gap-1.5">
          {dietary.map((tag) => <DietaryBadge tag={tag} />)}
          {allergens.map((code) => <AllergenBadge code={code} />)}
        </div>
      )}
    </div>
  </article>
)}
