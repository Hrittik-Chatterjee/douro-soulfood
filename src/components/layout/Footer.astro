---
/**
 * Footer — Option A: Floating Silver / Platinum Grey Card Layout
 *
 * Structure:
 * - Outer container sits on light/white page surface (bg-surface-primary).
 * - Main footer content is enclosed in a floating Silver / Platinum Grey capsule card
 *   (bg-neutral-100 border border-neutral-200 rounded-2xl shadow-xl).
 * - Top row: Logo (/dourologo.webp), navigation links, and D'ouro Brand Gold CTA button.
 * - Divider line & legal links inside the card.
 * - Outer bottom bar: Social icons, copyright notice, and location info.
 */

import Button from '@/components/ui/Button.astro';
import siteSettings from '@/content/settings/default.json';

interface FooterLink {
  label: string;
  href: string;
}

interface Props {
  tagline?: string;
  links?: FooterLink[];
  cta?: { label: string; href: string };
  address?: string[];
  phone?: string;
  phoneHref?: string;
  legalLinks?: FooterLink[];
  copyrightName?: string;
}

const currentYear = new Date().getFullYear();

const {
  tagline = 'Brasilianische Seele. Afro-Lateinische Aromen. Mitten in Salzburg. Mit Liebe gekocht, mit Herz serviert.',
  links = [
    { label: 'Speisekarte', href: '/menu' },
    { label: 'Catering & Events', href: '/catering' },
    { label: 'Über uns', href: '/about' },
    { label: 'Kontakt', href: '/contact' },
  ],
  cta = { label: 'Jetzt bestellen', href: siteSettings.lieferando_url || 'https://www.lieferando.at/en/menu/douro' },
  address = [`${siteSettings.address_line1}, ${siteSettings.postal_code} ${siteSettings.city}`],
  phone = siteSettings.phone || '+43 676 4231921',
  phoneHref = `tel:${(siteSettings.phone || '+43 676 4231921').replace(/[^+\d]/g, '')}`,
  legalLinks = [
    { label: 'Impressum', href: '/impressum' },
    { label: 'Datenschutz', href: '/datenschutz' },
  ],
  copyrightName = "D'ouro Soulfood Bistro",
} = Astro.props;
---

<footer class="bg-surface-primary pt-8 pb-16 md:pb-12 border-t border-border-subtle">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Main Floating Medium Silver Metallic Capsule Card -->
    <div class="bg-zinc-300/90 border border-zinc-300/90 backdrop-blur-md rounded-2xl p-6 sm:p-8 md:p-10 shadow-xl transition-all duration-300">

      <!-- Top Row: Logo, Nav Links, Order CTA -->
      <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8 lg:gap-12">

        <!-- Left: Logo & Tagline -->
        <div class="flex flex-col gap-3 max-w-sm shrink-0">
          <a
            href="/"
            class="inline-block no-underline hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold rounded-xs"
            aria-label="D'ouro Soulfood Homepage"
          >
            <img
              src="/dourologo.webp"
              alt="D'ouro Soulfood Logo"
              width="292"
              height="139"
              class="h-10 md:h-12 w-auto object-contain transition-transform duration-200 hover:scale-105"
            />
          </a>
          <p class="text-xs md:text-sm text-zinc-700 leading-relaxed font-sans font-medium">
            {tagline}
          </p>
        </div>

        <!-- Middle: Navigation Links -->
        <nav
          class="flex flex-wrap items-center gap-x-6 gap-y-3"
          aria-label="Footer Navigation"
        >
          {links.map((link) => (
            <a
              href={link.href}
              class="inline-flex items-center min-h-12 md:min-h-0 text-sm md:text-base font-bold text-zinc-900 hover:text-brand-gold-ink
                     no-underline transition-colors duration-200 rounded-sm"
            >
              {link.label}
            </a>
          ))}
        </nav>

        <!-- Right: Primary Order CTA Button (D'ouro Brand Gold) -->
        <div class="shrink-0">
          <Button
            href={cta.href}
            target="_blank"
            rel="noopener noreferrer"
            variant="primary"
            size="lg"
            arrow
            class="text-sm md:text-base font-extrabold tracking-wider uppercase shadow-md hover:shadow-lg hover:scale-[1.02]"
          >
            {cta.label}
          </Button>
        </div>
      </div>

      <!-- Horizontal Divider Line -->
      <div class="border-t border-zinc-300 my-6 md:my-8"></div>

      <!-- Inner Bottom Row: Legal Links -->
      <div class="flex flex-wrap items-center gap-6">
        {legalLinks.map((link) => (
          <a
            href={link.href}
            class="inline-flex items-center min-h-12 md:min-h-0 text-xs md:text-sm font-bold text-zinc-700 hover:text-zinc-950
                   no-underline transition-colors duration-200"
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>

    <!-- Slot for additional footer content -->
    <slot />

    <!-- Outer Bottom Bar: Social Icons, Copyright, Contact -->
    <div class="mt-8 pt-4 flex flex-col md:flex-row items-center justify-between gap-4 text-text-tertiary text-xs md:text-sm">

      <!-- Left: Social Media Icons -->
      <div class="flex items-center gap-1.5">
        <!-- Instagram -->
        <a
          href="https://www.instagram.com"
          target="_blank"
          rel="noopener noreferrer"
          class="p-3 text-text-tertiary hover:text-brand-gold transition-colors duration-200"
          aria-label="Instagram"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
          </svg>
        </a>

        <!-- Facebook -->
        <a
          href="https://www.facebook.com/dourosoulfood/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-3 text-text-tertiary hover:text-brand-gold transition-colors duration-200"
          aria-label="Facebook"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
          </svg>
        </a>

        <!-- Phone / Contact Link -->
        <a
          href={phoneHref}
          class="text-xs text-text-tertiary hover:text-brand-gold-ink transition-colors duration-200 no-underline"
        >
          {phone}
        </a>
      </div>

      <!-- Center: Copyright Notice -->
      <div class="text-center">
        <p class="text-text-tertiary">
          &copy; {currentYear} {copyrightName}. Alle Rechte vorbehalten.
        </p>
      </div>

      <!-- Right: Location -->
      <div class="text-right">
        <address class="text-text-tertiary not-italic">
          {address[0]}
        </address>
      </div>
    </div>
  </div>
</footer>
