---
/**
 * MobileBottomBar — Sticky bottom bar for mobile screens (< 768px).
 *
 * Features:
 * - Square, full-width container sitting flush at the very bottom (no gaps at bottom or sides).
 * - Rounded buttons inside the container.
 * - Glassmorphic container background (.glass).
 * - Automatic safe area bottom padding adjustment.
 */

import { settings, phoneHref, orderUrl as orderHref } from '@/lib/site';

const phone = settings.phone;
---

<nav data-mobile-bottom-bar aria-label="Schnellzugriff: Anrufen und Bestellen" class="mobile-bottom-bar fixed bottom-0 left-0 right-0 z-[60] flex lg:hidden gap-2 p-3 rounded-none bg-brand-espresso/98 backdrop-blur-md shadow-2xl border-t border-white/10">
  <!-- Call Button (Filled Terracotta Style with Rounded Corners) -->
  <a
    href={phoneHref}
    class="btn-call flex-1 flex min-h-11 items-center justify-center gap-2 text-sm font-bold tracking-wider uppercase no-underline rounded-sm"
    aria-label="Jetzt anrufen"
  >
    <svg class="phone-ring-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
    </svg>
    <span>Anrufen</span>
  </a>

  <!-- Order Online Button (Filled Gold Style with Rounded Corners) -->
  <a
    href={orderHref}
    class="btn-order flex-1 flex min-h-11 items-center justify-center gap-2 text-sm font-bold tracking-wider uppercase no-underline rounded-sm shadow-glow-gold"
    aria-label="Jetzt online bestellen"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
      <line x1="3" y1="6" x2="21" y2="6"/>
      <path d="M16 10a4 4 0 0 1-8 0"/>
    </svg>
    <span>Jetzt bestellen</span>
  </a>
</nav>

<style>
  .mobile-bottom-bar {
    padding-bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px));
    transition: transform var(--duration-fast) var(--ease-spring);
  }

  /* Hidden while scrolling down; shown at page top or while scrolling up. */
  .mobile-bottom-bar[data-hidden='true'] {
    transform: translateY(100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-bottom-bar {
      transition: none;
    }
  }

  .btn-call, .btn-order {
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
  }

  .btn-call {
    background-color: var(--color-brand-terracotta);
    color: var(--color-brand-cream);
    transition: background-color var(--duration-fast) var(--ease-spring);
  }

  .btn-call:hover {
    background-color: var(--color-brand-terracotta-light);
  }

  .btn-call:active {
    background-color: var(--color-brand-terracotta-dark);
  }

  .btn-order {
    background-color: var(--color-brand-gold);
    color: var(--color-brand-espresso);
    transition: background-color var(--duration-fast) var(--ease-spring);
  }

  .btn-order:hover {
    background-color: var(--color-brand-gold-light);
  }

  .btn-order:active {
    background-color: var(--color-brand-gold-dark);
  }

  /* Phone Ring Animation */
  @keyframes phone-ring {
    0%, 100% {
      transform: rotate(0deg);
    }
    5% {
      transform: rotate(15deg);
    }
    10% {
      transform: rotate(-13deg);
    }
    15% {
      transform: rotate(14deg);
    }
    20% {
      transform: rotate(-12deg);
    }
    25% {
      transform: rotate(10deg);
    }
    30% {
      transform: rotate(0deg);
    }
  }

  .phone-ring-icon {
    animation: phone-ring 3s ease-in-out infinite;
    transform-origin: center center;
  }

  /* Respect reduced motion preferences */
  @media (prefers-reduced-motion: reduce) {
    .phone-ring-icon {
      animation: none;
    }
  }
</style>

<script>
  // Hide the bar while scrolling down, reveal it while scrolling up, and
  // always keep it visible at the very top of the page (it's a persistent
  // quick-access CTA alongside the hero's own CTAs).
  const bar = document.querySelector<HTMLElement>('[data-mobile-bottom-bar]');

  if (bar) {
    const HIDE_THRESHOLD = 10; // px of scroll delta before reacting — avoids jitter from rubber-band overscroll
    let lastScrollY = window.scrollY;

    const handleScroll = () => {
      const currentScrollY = window.scrollY;

      if (currentScrollY <= 0) {
        bar.dataset.hidden = 'false';
        bar.removeAttribute('inert');
      } else {
        const delta = currentScrollY - lastScrollY;
        if (delta > HIDE_THRESHOLD) {
          bar.dataset.hidden = 'true';
          // translateY(100%) only moves the bar visually off-screen;
          // without `inert` its links stay focusable, so a keyboard/screen-
          // reader user could tab into invisible controls while it's hidden.
          bar.setAttribute('inert', '');
          lastScrollY = currentScrollY;
        } else if (delta < -HIDE_THRESHOLD) {
          bar.dataset.hidden = 'false';
          bar.removeAttribute('inert');
          lastScrollY = currentScrollY;
        }
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
  }
</script>
