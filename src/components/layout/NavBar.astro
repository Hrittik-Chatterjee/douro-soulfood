---
/**
 * NavBar — Dynamic Dual-State Header + Mobile Capsule Trigger
 *
 * - Mobile capsule navbar containing German "Speisekarte" button + hamburger icon,
 *   which toggles the full-screen drawer rendered by MobileNavDrawer.astro.
 * - Desktop dual-state scroll transition (transparent top vs solid dark on scroll).
 */

import MobileNavDrawer from './MobileNavDrawer.astro';
import { NAV_LINKS, type NavLink } from '@/lib/nav';
import { t } from '@/lib/i18n/ui';

interface Props {
  links?: NavLink[];
  ctaPrimary?: { label: string; href: string };
  ctaSecondary?: { label: string; href: string };
  class?: string;
}

const {
  links = NAV_LINKS,
  ctaPrimary = { label: 'Jetzt bestellen', href: 'https://www.lieferando.at/en/menu/douro' },
  ctaSecondary = { label: 'Reservierung', href: '/contact' },
  class: className = '',
} = Astro.props;
---

<nav
  aria-label="Hauptmenü"
  class:list={[
    'fixed top-0 inset-x-0 z-50 py-3 md:py-4 transition-all duration-300 ease-out',
    className,
  ]}
  data-nav
  data-scrolled="false"
>
  <!-- Dedicated Full-Width Background Layer (Desktop Smooth Fade) -->
  <div
    data-scrolled-bg
    class="absolute inset-0 bg-brand-espresso/95 backdrop-blur-md border-b border-white/10 shadow-2xl transition-opacity duration-300 ease-out pointer-events-none -z-10 opacity-0"
  >
  </div>

  <div class="relative z-10 mx-auto flex max-w-7xl items-center justify-between px-4 md:px-12">
    <!-- Left: Logo Image Only -->
    <div class="shrink-0">
      <a
        href="/"
        class="flex items-center no-underline hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold rounded-xs"
        aria-label="D'ouro Soulfood Homepage"
      >
        <img
          src="/dourologo.webp"
          alt="D'ouro Soulfood Logo"
          width="292"
          height="139"
          class="h-10 md:h-12 w-auto object-contain transition-transform duration-300 hover:scale-105"
        />
      </a>
    </div>

    <!-- Right: Desktop Navigation Container (SSOT: rounded-md) -->
    <div class="hidden lg:flex items-center">
      <div
        data-capsule
        class="flex items-center gap-3 rounded-md px-4 py-2 bg-brand-espresso/90 border border-white/15 backdrop-blur-md shadow-2xl transition-all duration-300 ease-out"
      >
        <!-- Nav links -->
        <div class="flex items-center gap-1">
          {
            links.map((link) => (
              <a
                href={link.href}
                class="px-3.5 py-2 text-sm font-bold tracking-wider uppercase text-white hover:text-brand-gold
                     no-underline transition-colors duration-200 rounded-sm"
              >
                {link.label}
              </a>
            ))
          }
        </div>

        <!-- Secondary Button (Reservierung — SSOT: rounded-sm = 10px) -->
        {
          ctaSecondary && (
            <a
              href={ctaSecondary.href}
              class="px-4 py-2 text-sm font-bold tracking-wider uppercase text-white rounded-sm border border-white/20
                   hover:bg-white/10 hover:border-white/40 no-underline transition-all duration-200"
            >
              {ctaSecondary.label}
            </a>
          )
        }

        <!-- Primary CTA (D'ouro Brand Gold — SSOT: rounded-sm = 10px) -->
        {
          ctaPrimary && (
            <a
              href={ctaPrimary.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center gap-1.5 px-5 py-2 text-sm font-extrabold tracking-wider uppercase rounded-sm
                   bg-brand-gold hover:bg-brand-gold-light active:bg-brand-gold-dark text-brand-espresso
                   no-underline transition-all duration-200 shadow-md hover:shadow-lg hover:scale-[1.02]"
            >
              <span>{ctaPrimary.label}</span>
              <svg
                class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="9 18 15 12 9 6" />
              </svg>
            </a>
          )
        }
      </div>
    </div>

    <!-- Mobile Navigation Capsule (SSOT: rounded-md container, rounded-sm button) -->
    <div class="flex lg:hidden items-center">
      <div
        class="flex items-center gap-2 bg-brand-espresso/90 border border-white/15 backdrop-blur-md rounded-md px-2.5 py-1.5 shadow-2xl"
      >
        <!-- German "Speisekarte" Link Button (SSOT: rounded-sm = 10px) -->
        <a
          href="/menu"
          class="flex min-h-12 items-center px-3 py-1 text-xs font-extrabold tracking-wide text-white border border-white/20 rounded-sm
                 hover:bg-white/10 no-underline transition-colors"
        >
          Speisekarte
        </a>

        <!-- Hamburger Icon Toggle Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="flex justify-center items-center w-11 h-11 rounded-sm text-white focus:outline-none"
          aria-label={t('nav.drawer.open')}
          data-label-open={t('nav.drawer.open')}
          data-label-close={t('nav.drawer.close')}
          aria-expanded="false"
        >
          <div class="flex flex-col gap-1.5 justify-center items-center w-5 h-5">
            <span
              class="block h-0.5 w-5 bg-white rounded-full transition-all duration-200"
              data-line-top></span>
            <span
              class="block h-0.5 w-5 bg-white rounded-full transition-all duration-200"
              data-line-mid></span>
            <span
              class="block h-0.5 w-5 bg-white rounded-full transition-all duration-200"
              data-line-bot></span>
          </div>
        </button>
      </div>
    </div>
  </div>
</nav>

<MobileNavDrawer links={links} />

<slot />

<script>
  // Desktop window.scrollY scroll handler
  const nav = document.querySelector('[data-nav]') as HTMLElement;
  const scrolledBg = document.querySelector('[data-scrolled-bg]') as HTMLElement;
  const capsule = document.querySelector('[data-capsule]') as HTMLElement;

  if (nav) {
    const handleScroll = () => {
      const isScrolled = window.scrollY > 20;

      if (isScrolled) {
        nav.dataset.scrolled = 'true';
        if (scrolledBg) scrolledBg.style.opacity = '1';
        if (capsule) {
          capsule.style.backgroundColor = 'transparent';
          capsule.style.borderColor = 'transparent';
          capsule.style.boxShadow = 'none';
        }
      } else {
        nav.dataset.scrolled = 'false';
        if (scrolledBg) scrolledBg.style.opacity = '0';
        if (capsule) {
          capsule.style.backgroundColor = '';
          capsule.style.borderColor = '';
          capsule.style.boxShadow = '';
        }
      }
    };

    handleScroll();
    window.addEventListener('scroll', handleScroll, { passive: true });
  }
  // Mobile drawer open/close/Escape logic lives in MobileNavDrawer.astro
</script>
