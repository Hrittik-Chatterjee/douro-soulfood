---
/**
 * MobileNavDrawer — Full-screen mobile navigation overlay.
 *
 * Split out of NavBar.astro: this is the drawer content triggered by
 * NavBar's hamburger button (#mobile-menu-btn). Astro doesn't scope
 * <script> tags to a component's subtree, so the open/close/Escape
 * logic here talks to that button by id regardless of component
 * boundaries — safe to keep as two separate components.
 */
interface NavLink {
  label: string;
  href: string;
}

interface Props {
  links: NavLink[];
}

const { links } = Astro.props;
---

<!-- Full-Screen Mobile Drawer Overlay (Top-Left Aligned List) -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-50 bg-brand-espresso/98 backdrop-blur-2xl
         opacity-0 pointer-events-none transition-all duration-300
         lg:hidden flex flex-col justify-start overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-label="Navigationsmenü"
  aria-hidden="true"
  inert
  data-open="false"
>
  <!-- Top Bar inside open mobile menu (padding matches NavBar's row exactly, so logo/button don't shift on open) -->
  <div class="flex items-center justify-between w-full shrink-0 px-4 md:px-12 py-3 md:py-4">
    <a href="/" class="flex items-center no-underline">
      <img src="/dourologo.webp" alt="D'ouro Soulfood Logo" width="292" height="139" class="h-10 md:h-12 w-auto object-contain" />
    </a>

    <!-- Capsule with Speisekarte + Close X Icon (SSOT: rounded-md container, rounded-sm button) -->
    <div class="flex items-center gap-2 bg-brand-espresso/90 border border-white/15 backdrop-blur-md rounded-md px-2.5 py-1.5 shadow-2xl">
      <a
        href="/menu"
        class="flex min-h-12 items-center px-3 py-1 text-xs font-extrabold tracking-wide text-white border border-white/20 rounded-sm no-underline"
      >
        Speisekarte
      </a>
      <button
        id="mobile-menu-close-btn"
        type="button"
        class="flex justify-center items-center w-11 h-11 text-white focus:outline-none"
        aria-label="Navigationsmenü schließen"
      >
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Main Navigation Links List (Top-Left Aligned) -->
  <nav aria-label="Mobile Navigation Drawer" class="flex flex-col items-start text-left gap-6 px-4 md:px-12 pt-8 pb-28">
    {links.map((link) => (
      <a
        href={link.href}
        class="text-2xl font-bold tracking-wide uppercase text-white hover:text-brand-gold no-underline transition-colors"
      >
        {link.label}
      </a>
    ))}
  </nav>
</div>

<script>
  // Mobile drawer open/close/Escape logic.
  // Talks to NavBar's #mobile-menu-btn by id, not by component subtree.
  const btn = document.getElementById('mobile-menu-btn');
  const closeBtn = document.getElementById('mobile-menu-close-btn');
  const menu = document.getElementById('mobile-menu');

  function getFocusable(): HTMLElement[] {
    if (!menu) return [];
    return Array.from(menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));
  }

  function openMenu() {
    if (menu) {
      menu.dataset.open = 'true';
      menu.classList.remove('opacity-0', 'pointer-events-none');
      menu.removeAttribute('inert');
      menu.setAttribute('aria-hidden', 'false');
    }
    btn?.setAttribute('aria-expanded', 'true');
    btn?.setAttribute('aria-label', 'Navigationsmenü schließen');
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  }

  function closeMenu() {
    if (menu) {
      menu.dataset.open = 'false';
      menu.classList.add('opacity-0', 'pointer-events-none');
      menu.setAttribute('inert', '');
      menu.setAttribute('aria-hidden', 'true');
    }
    btn?.setAttribute('aria-expanded', 'false');
    btn?.setAttribute('aria-label', 'Navigationsmenü öffnen');
    document.body.style.overflow = '';
  }

  btn?.addEventListener('click', () => {
    const isOpen = menu?.dataset.open === 'true';
    if (isOpen) closeMenu();
    else openMenu();
  });

  closeBtn?.addEventListener('click', () => {
    closeMenu();
    btn?.focus();
  });

  document.addEventListener('keydown', (e) => {
    if (menu?.dataset.open !== 'true') return;

    if (e.key === 'Escape') {
      closeMenu();
      btn?.focus();
      return;
    }

    if (e.key === 'Tab') {
      const focusable = getFocusable();
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
</script>
