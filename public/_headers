/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # script-src 'self' below is a PLACEHOLDER that is widened at build time.
  # src/integrations/csp-hashes.mjs computes a SHA-256 for every inline <script>
  # in the real build output and injects them into dist/client/_headers (the
  # copy Cloudflare actually serves). Hashes are deliberately NOT committed
  # here: JSON-LD is derived from Keystatic content, so a routine CMS edit
  # changes the rendered bytes, and a stale hash breaks scripts with no build
  # error, no test failure and no visible symptom — only a console violation.
  # Keep the literal string "script-src 'self'" intact; the build fails loudly
  # if that placeholder is missing. If the hook ever fails to run, the shipped
  # policy is over-restrictive rather than permissive — it fails closed.
  # Verified independently post-build by scripts/checks/verify-csp-hashes.mjs.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; frame-src https://maps.google.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'

# Hashed build output — filename changes on every content change, safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts — versioned by filename, effectively immutable.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Hero background videos — large, rarely-changing assets.
/*.mp4
  Cache-Control: public, max-age=604800

# CMS-uploaded photos — content can change without a filename change, so a
# shorter max-age with revalidation avoids serving stale images after an edit.
/images/*
  Cache-Control: public, max-age=86400, must-revalidate
